# tlog-web 后端配置示例（复制为 .env 后修改）
# 部署前务必修改 TLOG_KEY / TLOG_SECRET 为强密码/随机串

# ---- 认证（单 admin 用户，JWT token 登录）----
TLOG_USER=admin
TLOG_KEY=changeme-change-me
# JWT 签名密钥：必须设为独立随机长字符串（建议 32+ 字节），不要复用 TLOG_KEY
TLOG_SECRET=generate-a-random-secret-here

# ---- 采集与存储 ----
LOG_DIR=/var/log/tlog
LOG_FILE=tlog-session.log
DB_PATH=/data/tlog.db
STATE_PATH=/data/collector.state

# ---- 保留策略 ----
RETENTION_DAYS=7            # 会话索引与回放文件保留天数(默认7天)

# ---- 回放 ----
SPEED_MAX=8                  # 回放速度上限（x）
HTTP_ADDR=0.0.0.0:8080
